rules_version = '2';

// ===========================================================================
// PMExps — Firestore Security Rules
//
// Posture: deny by default. Nothing is readable or writable unless a rule
// below explicitly allows it.
//
// ARCHITECTURE NOTE — no Cloud Functions.
// This project runs on the Spark (free) plan, so there is no trusted server
// process. Balance-affecting operations are therefore performed as Firestore
// TRANSACTIONS from the client, and the invariants that a Cloud Function
// would have enforced are enforced here instead, using getAfter() to inspect
// the post-commit state of sibling documents.
//
// The security property is preserved: a client may submit a transaction, but
// Firestore rejects the entire commit unless every document in it satisfies
// these rules together. A tampered browser cannot allocate a voucher number
// out of sequence, confirm an entry without incrementing the counter, or
// write one half of a transfer.
//
// Three things are true of every financial write path here:
//   1. Authentication alone grants nothing. Access requires an ACTIVE member
//      document at workspaces/{wid}/members/{uid}.
//   2. Clients may only ever write documents in 'draft' status. Confirmation,
//      locking, transfers, corrections and voucher allocation have NO client
//      write path at all — they are callable Cloud Functions using the Admin
//      SDK, which bypasses these rules by design.
//   3. Role fields, counters, summaries and audit logs are unwritable by
//      clients under every circumstance, so privilege escalation and history
//      rewriting are structurally impossible rather than merely disallowed.
//
// Tests proving cross-workspace access is rejected: tests/rules/
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity and membership helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid);
    }

    function memberDoc(wid) {
      return get(memberPath(wid)).data;
    }

    // An ACTIVE member. 'invited' and 'deactivated' grant nothing.
    function isMember(wid) {
      let m = isSignedIn() ? memberOf(wid) : null;
      return m != null && m.data.status == 'active';
    }

    function memberRole(wid) {
      return memberDoc(wid).role;
    }

    // Every get() and exists() counts against a hard ceiling: 10 document
    // accesses for an ordinary request, 20 across an entire transaction.
    //
    // A transfer writes five documents at once — the transfer, both ledger
    // legs, the counter and an audit row — and Firestore evaluates rules for
    // each. Written naively, with exists() followed by two or three separate
    // get() calls per check, the role helpers alone consumed the whole budget
    // and the transaction failed with a limit error rather than a rule error,
    // which is a miserable thing to debug.
    //
    // The `let` binding reads the member document exactly once per call.
    // get() on a missing document returns null, and the null check short-
    // circuits before .data is touched, so a non-member is denied rather than
    // causing an evaluation error.

    function memberOf(wid) {
      return get(memberPath(wid));
    }

    function isSuperAdmin(wid) {
      let m = isSignedIn() ? memberOf(wid) : null;
      return m != null && m.data.status == 'active' && m.data.role == 'superAdmin';
    }

    function isAccountant(wid) {
      let m = isSignedIn() ? memberOf(wid) : null;
      return m != null && m.data.status == 'active' && m.data.role == 'accountant';
    }

    function isViewer(wid) {
      let m = isSignedIn() ? memberOf(wid) : null;
      return m != null && m.data.status == 'active' && m.data.role == 'viewer';
    }

    // Anyone who may originate or confirm a financial entry.
    function canWriteEntries(wid) {
      let m = isSignedIn() ? memberOf(wid) : null;
      return m != null
        && m.data.status == 'active'
        && m.data.role in ['superAdmin', 'accountant'];
    }

    // ---------------------------------------------------------------------
    // Workspace settings helpers
    // ---------------------------------------------------------------------

    function accountingSettings(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)/settings/accounting).data;
    }

    // A ledger date is locked when it is on or before the workspace lock date.
    // ISO YYYY-MM-DD compares correctly as a string.
    function isDateLocked(wid, ledgerDate) {
      let settings = accountingSettings(wid);
      return settings.lockDate != null && ledgerDate <= settings.lockDate;
    }

    // ---------------------------------------------------------------------
    // Field and value validators
    // ---------------------------------------------------------------------

    function isLedgerDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Money is an integer number of paise, strictly positive, under ~₹100 cr.
    function isPositivePaise(value) {
      return value is int && value > 0 && value <= 99999999999;
    }

    function isPaise(value) {
      return value is int && value >= -99999999999 && value <= 99999999999;
    }

    function isBoundedString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    // The set of fields this write is attempting to change.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when the write touches none of the named fields.
    function untouched(fields) {
      return !changedKeys().hasAny(fields);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // A document's workspaceId must agree with the path it is stored at.
    // Belt and braces: the path already isolates tenants, but collection-group
    // queries and rebuild scripts read the field, so the two must never drift.
    function workspaceIdMatches(wid) {
      return incoming().workspaceId == wid;
    }

    // Server timestamps only. A client clock is never trusted for audit order.
    function hasServerCreatedAt() {
      return incoming().createdAt == request.time;
    }

    function hasServerUpdatedAt() {
      return incoming().updatedAt == request.time;
    }

    // ===================================================================
    // Collection-group read over `members`.
    //
    // The workspace picker needs "every workspace I belong to" without first
    // knowing the workspace IDs, which a path-scoped rule cannot serve: in a
    // collection-group query the {wid} wildcard is unbound, so isMember(wid)
    // has nothing to resolve against.
    //
    // This rule is safe because Firestore rejects any collection-group query
    // that could return a document failing it. The client is therefore forced
    // to filter by uid == its own, and cannot enumerate other people's
    // memberships even by asking for them.
    // ===================================================================

    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ===================================================================
    // users/{uid} — profile only. Roles are never stored here.
    // ===================================================================

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      // A user may create their own profile on first sign-in, but cannot
      // create it pre-disabled or with fields they do not own.
      allow create: if isSelf(uid)
        && incoming().uid == uid
        && incoming().email == request.auth.token.email
        && isBoundedString(incoming().displayName, 1, 80)
        && incoming().disabled == false
        && incoming().locale in ['en', 'gu']
        && incoming().theme in ['dark', 'light', 'system']
        && hasServerCreatedAt();

      // Only self-service preference fields are updatable from the client.
      allow update: if isSelf(uid)
        && untouched([
             'uid', 'email', 'disabled', 'createdAt'
           ].toSet())
        && isBoundedString(incoming().displayName, 1, 80)
        && incoming().locale in ['en', 'gu']
        && incoming().theme in ['dark', 'light', 'system']
        && hasServerUpdatedAt();

      allow delete: if false;
    }

    // ===================================================================
    // userWorkspaceIndex/{uid} — read-only cache maintained by a trigger.
    // Rules NEVER consult this for authorisation; members/ is authoritative.
    // ===================================================================

    match /userWorkspaceIndex/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // ===================================================================
    // workspaces/{workspaceId}
    // ===================================================================

    match /workspaces/{wid} {

      allow get: if isMember(wid);

      // No workspace enumeration. The picker reads userWorkspaceIndex.
      allow list: if false;

      // Workspace creation is a client transaction that must, in the same
      // commit, create the creator's own member document as an active Super
      // Admin. getAfter() reads the post-commit state of that member doc, so
      // a workspace can never exist without exactly one Super Admin, and the
      // creator cannot make someone else the owner.
      // Reads the member document being created in this same commit, once.
      function creatorBecomesSuperAdmin() {
        let m = getAfter(memberPath(wid)).data;
        return m.role == 'superAdmin'
          && m.status == 'active'
          && m.uid == request.auth.uid;
      }

      allow create: if isSignedIn()
        && incoming().workspaceId == wid
        && incoming().ownerUid == request.auth.uid
        && incoming().createdBy == request.auth.uid
        && isBoundedString(incoming().name, 1, 100)
        && incoming().type in ['personal', 'family', 'business']
        && incoming().currency == 'INR'
        && incoming().status == 'active'
        && incoming().memberCount == 1
        && hasServerCreatedAt()
        && creatorBecomesSuperAdmin();

      allow update: if isSuperAdmin(wid)
        && untouched([
             'workspaceId', 'ownerUid', 'memberCount', 'status',
             'currency', 'createdAt', 'createdBy'
           ].toSet())
        && isBoundedString(incoming().name, 1, 100)
        && isOptionalString(incoming().businessName, 120)
        && isOptionalString(incoming().address, 300)
        && hasServerUpdatedAt();

      allow delete: if false;

      // -----------------------------------------------------------------
      // members — the permission record. Zero client write paths.
      //
      // This is the single most important block in the file. Because no
      // client can write a role field anywhere, a user cannot elevate
      // themselves even if every UI control were bypassed.
      // -----------------------------------------------------------------

      match /members/{memberUid} {
        allow get: if isMember(wid);
        allow list: if isMember(wid);

        // Two — and only two — ways a member document may be created.
        //
        // 1. BOOTSTRAP. The workspace does not exist yet, so this write is
        //    part of the create-workspace transaction above. The only member
        //    that may be created is the caller, as Super Admin. Because the
        //    workspace must not already exist, this path cannot be replayed
        //    later to mint a second Super Admin.
        //
        // 2. INVITE. An existing Super Admin invites someone else. The new
        //    member starts as 'invited', never 'active', and the inviter may
        //    not create a document for themselves through this path.
        allow create: if isSignedIn()
          && incoming().uid == memberUid
          && incoming().workspaceId == wid
          && incoming().role in ['superAdmin', 'accountant', 'viewer']
          && hasServerCreatedAt()
          && (
               (
                 // 1. Bootstrap
                 memberUid == request.auth.uid
                 && !exists(/databases/$(database)/documents/workspaces/$(wid))
                 && incoming().role == 'superAdmin'
                 && incoming().status == 'active'
               )
               || (
                 // 2. Invite
                 memberUid != request.auth.uid
                 && isSuperAdmin(wid)
                 && incoming().status == 'invited'
                 && incoming().invitedBy == request.auth.uid
               )
             );

        // Role and status changes: Super Admin only, and never on oneself.
        // Self-exclusion is what prevents a Super Admin being tricked into
        // demoting the last one, and prevents any self-elevation outright.
        allow update: if isSuperAdmin(wid)
          && memberUid != request.auth.uid
          && untouched(['uid', 'workspaceId', 'createdAt'].toSet())
          && incoming().role in ['superAdmin', 'accountant', 'viewer']
          && incoming().status in ['active', 'invited', 'deactivated']
          // The workspace owner cannot be demoted or deactivated by anyone.
          && memberUid != get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerUid
          && hasServerUpdatedAt();

        // A member accepting their own invitation: invited -> active only.
        allow update: if isSelf(memberUid)
          && existing().status == 'invited'
          && incoming().status == 'active'
          && changedKeys().hasOnly(['status', 'joinedAt', 'updatedAt'])
          && incoming().joinedAt == request.time
          && hasServerUpdatedAt();

        // Membership is deactivated, never deleted: audit trails reference it.
        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // accounts — Super Admin manages; everyone reads. Never deleted.
      // -----------------------------------------------------------------

      match /accounts/{accountId} {
        allow get, list: if isMember(wid);

        allow create: if isSuperAdmin(wid)
          && workspaceIdMatches(wid)
          && incoming().accountId == accountId
          && isBoundedString(incoming().name, 1, 60)
          && incoming().type in ['cash', 'bank', 'upiCard', 'party']
          && isPaise(incoming().openingBalancePaise)
          && isLedgerDate(incoming().openingBalanceDate)
          && incoming().currency == 'INR'
          && incoming().isActive is bool
          && incoming().isSystem is bool
          && hasServerCreatedAt();

        allow update: if isSuperAdmin(wid)
          && untouched([
               'accountId', 'workspaceId', 'isSystem', 'currency', 'createdAt', 'createdBy'
             ].toSet())
          && isBoundedString(incoming().name, 1, 60)
          && incoming().type in ['cash', 'bank', 'upiCard', 'party']
          && isPaise(incoming().openingBalancePaise)
          && isLedgerDate(incoming().openingBalanceDate)
          && incoming().isActive is bool
          && hasServerUpdatedAt();

        // Deactivate instead. Historical entries must keep resolving.
        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // categories — as accounts. `type` immutability once used is enforced
      // in the Cloud Function, which can read entryCount reliably.
      // -----------------------------------------------------------------

      match /categories/{categoryId} {
        allow get, list: if isMember(wid);

        allow create: if isSuperAdmin(wid)
          && workspaceIdMatches(wid)
          && incoming().categoryId == categoryId
          && isBoundedString(incoming().name, 1, 60)
          && incoming().type in ['income', 'expense']
          && incoming().isActive is bool
          && incoming().isSystem is bool
          && incoming().entryCount == 0
          && hasServerCreatedAt();

        allow update: if isSuperAdmin(wid)
          && untouched([
               'categoryId', 'workspaceId', 'isSystem', 'entryCount',
               'createdAt', 'createdBy'
             ].toSet())
          && isBoundedString(incoming().name, 1, 60)
          && incoming().type in ['income', 'expense']
          // Changing type is only safe while unused; the function re-checks.
          && (incoming().type == existing().type || existing().entryCount == 0)
          && incoming().isActive is bool
          && hasServerUpdatedAt();

        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // ledgerEntries — drafts only from the client.
      //
      // Confirmation is a Cloud Function. There is no rule below that
      // permits a client to set status to 'confirmed', allocate a voucher
      // number, or modify a document that is already confirmed or locked.
      // -----------------------------------------------------------------

      match /ledgerEntries/{entryId} {

        // Fields a client may never write, in any operation.
        function serverOnlyEntryFields() {
          return [
            'voucherNumber', 'confirmedBy', 'confirmedByName', 'confirmedAt',
            'lockedBy', 'lockedAt', 'correctedBy', 'correctionOf',
            'reversalOf', 'correctionRequestId', 'transferId', 'transferLeg',
            'financialYear'
          ].toSet();
        }

        function validDraftShape() {
          return workspaceIdMatches(wid)
            && incoming().entryId == entryId
            && incoming().status == 'draft'
            && incoming().type in ['income', 'expense']
            && isPositivePaise(incoming().amountPaise)
            && isLedgerDate(incoming().ledgerDate)
            && isBoundedString(incoming().description, 1, 200)
            && isBoundedString(incoming().categoryId, 1, 64)
            && isBoundedString(incoming().accountId, 1, 64)
            && incoming().paymentMode in [
                 'cash', 'bankTransfer', 'upi', 'debitCard',
                 'creditCard', 'cheque', 'other'
               ]
            && isOptionalString(incoming().partyName, 100)
            && isOptionalString(incoming().referenceNumber, 50)
            && isOptionalString(incoming().remarks, 500)
            && incoming().attachments is list
            && incoming().attachments.size() <= 5
            && isBoundedString(incoming().clientRequestId, 8, 64)
            // A draft carries no voucher number and no confirmation trace.
            && incoming().voucherNumber == null
            && incoming().confirmedAt == null
            && incoming().lockedAt == null
            && incoming().transferId == null;
        }

        allow get, list: if isMember(wid);

        allow create: if canWriteEntries(wid)
          && validDraftShape()
          && incoming().enteredBy == request.auth.uid
          && !isDateLocked(wid, incoming().ledgerDate)
          && hasServerCreatedAt();

        // Editing a draft. Both the before and after state must be a draft,
        // so this can never be used to confirm or to alter confirmed history.
        allow update: if canWriteEntries(wid)
          && existing().status == 'draft'
          && validDraftShape()
          && untouched(serverOnlyEntryFields())
          && untouched(['entryId', 'workspaceId', 'enteredBy', 'createdAt'].toSet())
          && !isDateLocked(wid, incoming().ledgerDate)
          && !isDateLocked(wid, existing().ledgerDate)
          // Accountants edit their own drafts; Super Admin may edit any.
          && (isSuperAdmin(wid) || existing().enteredBy == request.auth.uid)
          && hasServerUpdatedAt();

        // -------------------------------------------------------------
        // CONFIRMATION — draft becomes confirmed.
        //
        // This is the rule that makes browser-issued confirmation safe
        // without a trusted server. Five things must hold together:
        //
        //   1. The status moves draft -> confirmed, nothing else.
        //   2. Every financial field is byte-identical to the draft. An
        //      amount or date cannot be altered on the way through.
        //   3. The voucher number equals the counter's value AFTER this
        //      same commit. getAfter() is what ties the two documents
        //      together: the number cannot be invented, and it cannot be
        //      reused, because the counter rule only allows +1.
        //   4. confirmedAt is the server's clock, not the device's.
        //   5. The ledger date is not in a closed period.
        // -------------------------------------------------------------

        function counterPath(prefix, year) {
          return /databases/$(database)/documents/workspaces/$(wid)/voucherCounters/$(prefix + '-' + year);
        }

        function expectedPrefix() {
          return existing().type == 'income' ? 'INC' : 'EXP';
        }

        // The number the counter will hold once this transaction commits.
        function committedSequence() {
          return getAfter(counterPath(expectedPrefix(), existing().financialYear)).data.lastNumber;
        }

        // 5-digit zero padding, expressed as string concatenation because
        // rules have no printf. Sequences above 99999 in one financial year
        // are refused rather than silently mis-padded.
        function padded(n) {
          return n < 10 ? '0000' + string(n)
            : n < 100 ? '000' + string(n)
            : n < 1000 ? '00' + string(n)
            : n < 10000 ? '0' + string(n)
            : n < 100000 ? string(n)
            : 'OVERFLOW';
        }

        function expectedVoucher() {
          return expectedPrefix() + '-' + existing().financialYear + '-' + padded(committedSequence());
        }

        // Fields that must not move during confirmation.
        function financialFieldsUnchanged() {
          return untouched([
            'entryId', 'workspaceId', 'ledgerDate', 'financialYear', 'type',
            'categoryId', 'categoryNameSnapshot', 'accountId',
            'accountNameSnapshot', 'description', 'partyName', 'paymentMode',
            'amountPaise', 'referenceNumber', 'remarks', 'attachments',
            'enteredBy', 'enteredByName', 'clientRequestId', 'createdAt',
            'correctionOf', 'reversalOf', 'transferId', 'transferLeg'
          ].toSet());
        }

        allow update: if canWriteEntries(wid)
          && existing().status == 'draft'
          && incoming().status == 'confirmed'
          && financialFieldsUnchanged()
          && incoming().voucherNumber == expectedVoucher()
          && incoming().confirmedBy == request.auth.uid
          && incoming().confirmedAt == request.time
          && !isDateLocked(wid, existing().ledgerDate)
          && hasServerUpdatedAt();

        // -------------------------------------------------------------
        // TRANSFER LEGS
        //
        // A leg is created already confirmed, because a half-written
        // transfer must never exist even momentarily. It is legal only
        // when the parent transfer document, in this same commit, points
        // back at this exact entry — so a leg cannot be conjured on its own
        // to move money into an account.
        // -------------------------------------------------------------

        function transferPath(tid) {
          return /databases/$(database)/documents/workspaces/$(wid)/transfers/$(tid);
        }

        // The parent transfer is read once. It must, after this commit, name
        // this exact entry as the matching leg and agree on amount and date —
        // so a leg cannot be conjured on its own to move money into an
        // account, and cannot disagree with the transfer it belongs to.
        function parentClaimsThisLeg() {
          let parent = getAfter(transferPath(incoming().transferId)).data;
          return (
              incoming().transferLeg == 'transferOut'
                ? parent.outEntryId == entryId
                : parent.inEntryId == entryId
            )
            && parent.amountPaise == incoming().amountPaise
            && parent.ledgerDate == incoming().ledgerDate;
        }

        allow create: if canWriteEntries(wid)
          && workspaceIdMatches(wid)
          && incoming().entryId == entryId
          && incoming().status == 'confirmed'
          && incoming().transferId is string
          && incoming().transferLeg in ['transferOut', 'transferIn']
          && isPositivePaise(incoming().amountPaise)
          && isLedgerDate(incoming().ledgerDate)
          && incoming().confirmedBy == request.auth.uid
          && incoming().confirmedAt == request.time
          && !isDateLocked(wid, incoming().ledgerDate)
          && parentClaimsThisLeg()
          && hasServerCreatedAt();

        // -------------------------------------------------------------
        // LOCKING
        //
        // Closing a period moves confirmed entries to 'locked'. Only a
        // Super Admin may do it, and nothing about the entry may change
        // except the lock fields.
        // -------------------------------------------------------------

        allow update: if isSuperAdmin(wid)
          && existing().status == 'confirmed'
          && incoming().status == 'locked'
          && changedKeys().hasOnly(['status', 'lockedBy', 'lockedAt', 'updatedAt'])
          && incoming().lockedBy == request.auth.uid
          && incoming().lockedAt == request.time
          && hasServerUpdatedAt();

        // Nothing financial is ever deleted. Drafts are retired to
        // 'voidDraft' through the update path above, keeping a recoverable
        // record rather than removing one.
        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // transfers — draft creation only. Confirmation writes two balanced
      // ledger legs and must be atomic, so it is function-only.
      // -----------------------------------------------------------------

      match /transfers/{transferId} {
        allow get, list: if isMember(wid);

        function legPathFor(entryId) {
          return /databases/$(database)/documents/workspaces/$(wid)/ledgerEntries/$(entryId);
        }

        // Shared shape checks for any new transfer.
        function validTransferShape() {
          return workspaceIdMatches(wid)
            && incoming().transferId == transferId
            && isPositivePaise(incoming().amountPaise)
            && isLedgerDate(incoming().ledgerDate)
            && isBoundedString(incoming().fromAccountId, 1, 64)
            && isBoundedString(incoming().toAccountId, 1, 64)
            // The one invariant that must hold in every case: money cannot
            // move to where it already is.
            && incoming().fromAccountId != incoming().toAccountId
            && isOptionalString(incoming().description, 200)
            && isOptionalString(incoming().remarks, 500)
            && isBoundedString(incoming().clientRequestId, 8, 64)
            && incoming().createdBy == request.auth.uid
            && !isDateLocked(wid, incoming().ledgerDate)
            && hasServerCreatedAt();
        }

        // A transfer saved for later, moving nothing yet.
        allow create: if canWriteEntries(wid)
          && validTransferShape()
          && incoming().status == 'draft'
          && incoming().voucherNumber == null
          && incoming().outEntryId == null
          && incoming().inEntryId == null;

        // -------------------------------------------------------------
        // A transfer created ALREADY CONFIRMED, with both legs written in
        // the same commit.
        //
        // This is the path the app actually uses. A transfer has no useful
        // half-state: either the money moved or it did not, so writing it
        // as a draft and immediately confirming would only create a window
        // in which the record exists and the balances disagree.
        //
        // getAfter() reads each leg's post-commit state, so this rule can
        // insist the pair balances before allowing the write. Omit a leg,
        // change one amount, or point a leg at the wrong account, and
        // getAfter() disagrees and the entire transaction is rejected.
        // -------------------------------------------------------------
        // Each leg is read exactly once and bound with `let`. Written as ten
        // separate getAfter() calls this consumed most of the transaction's
        // 20-access budget on its own, and the failure would have surfaced as
        // an opaque limit error rather than a rule refusal.
        function legsBalance() {
          let out = getAfter(legPathFor(incoming().outEntryId)).data;
          let arr = getAfter(legPathFor(incoming().inEntryId)).data;
          return out.transferId == transferId
            && arr.transferId == transferId
            && out.amountPaise == incoming().amountPaise
            && arr.amountPaise == incoming().amountPaise
            && out.ledgerDate == incoming().ledgerDate
            && arr.ledgerDate == incoming().ledgerDate
            && out.transferLeg == 'transferOut'
            && arr.transferLeg == 'transferIn'
            && out.accountId == incoming().fromAccountId
            && arr.accountId == incoming().toAccountId;
        }

        allow create: if canWriteEntries(wid)
          && validTransferShape()
          && incoming().status == 'confirmed'
          && incoming().voucherNumber is string
          && incoming().outEntryId is string
          && incoming().inEntryId is string
          && incoming().outEntryId != incoming().inEntryId
          && incoming().confirmedBy == request.auth.uid
          && incoming().confirmedAt == request.time
          && legsBalance();

        allow update: if canWriteEntries(wid)
          && existing().status == 'draft'
          && incoming().status == 'draft'
          && incoming().fromAccountId != incoming().toAccountId
          && isPositivePaise(incoming().amountPaise)
          && untouched([
               'transferId', 'workspaceId', 'voucherNumber', 'outEntryId',
               'inEntryId', 'confirmedBy', 'confirmedAt', 'createdBy',
               'createdAt', 'reversalOfTransferId', 'reversedByTransferId'
             ].toSet())
          && (isSuperAdmin(wid) || existing().createdBy == request.auth.uid)
          && !isDateLocked(wid, incoming().ledgerDate)
          && hasServerUpdatedAt();

        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // correctionRequests — request from the client, approve from a
      // function. A requester may cancel their own pending request.
      // -----------------------------------------------------------------

      match /correctionRequests/{requestId} {
        allow get, list: if isMember(wid);

        allow create: if canWriteEntries(wid)
          && workspaceIdMatches(wid)
          && incoming().requestId == requestId
          && incoming().status == 'pending'
          && incoming().targetType in ['ledgerEntry', 'transfer']
          && isBoundedString(incoming().targetId, 1, 64)
          // A reason is mandatory and must be substantive.
          && isBoundedString(incoming().reason, 10, 500)
          && incoming().requestedBy == request.auth.uid
          && incoming().reviewedBy == null
          && incoming().reversalEntryId == null
          && incoming().replacementEntryId == null
          && isBoundedString(incoming().clientRequestId, 8, 64)
          && hasServerCreatedAt();

        // The only client update is the requester withdrawing it.
        allow update: if isMember(wid)
          && existing().status == 'pending'
          && existing().requestedBy == request.auth.uid
          && incoming().status == 'cancelled'
          && changedKeys().hasOnly(['status', 'updatedAt'])
          && hasServerUpdatedAt();

        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // auditLogs — append-only, and not even append from a client.
      // -----------------------------------------------------------------

      match /auditLogs/{auditId} {
        // Super Admin sees everything; an Accountant sees only their own
        // actions ("Limited" in the capability matrix); Viewer sees none.
        allow get, list: if isSuperAdmin(wid)
          || (isAccountant(wid) && resource.data.actorUid == request.auth.uid);

        // Append-only. A member may add a row describing their own action,
        // and nobody — at any role — may ever change or remove one.
        //
        // actorUid is pinned to the caller so an audit row cannot be written
        // in someone else's name, and serverTimestamp must be the server's
        // clock so the ordering of history cannot be forged by a device with
        // a wrong date.
        allow create: if isMember(wid)
          && incoming().workspaceId == wid
          && incoming().actorUid == request.auth.uid
          && incoming().actorName is string
          && incoming().action is string
          && incoming().entityType is string
          && incoming().entityId is string
          && incoming().serverTimestamp == request.time;

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------
      // Derived and protected collections — readable, never client-written.
      // -----------------------------------------------------------------

      match /dailySummaries/{summaryId} {
        allow get, list: if isMember(wid);
        allow write: if false;
      }

      match /accountBalances/{accountId} {
        allow get, list: if isMember(wid);
        allow write: if false;
      }

      match /voucherCounters/{counterId} {
        // Readable, because without Cloud Functions the confirming client
        // must read the counter inside its transaction to know the next
        // number. Reading it grants nothing: the entry rule below checks the
        // number actually written against this counter's post-commit value.
        allow get: if isMember(wid);
        allow list: if false;

        // The only permitted change is an increase of exactly one. A client
        // cannot set the counter backwards to reuse a number, cannot jump it
        // to skip a range, and cannot decrement it to free one up.
        allow create: if canWriteEntries(wid)
          && incoming().counterId == counterId
          && incoming().workspaceId == wid
          && incoming().lastNumber == 1
          && incoming().prefix in ['INC', 'EXP', 'TRF', 'COR']
          && incoming().financialYear is string;

        allow update: if canWriteEntries(wid)
          && incoming().lastNumber == existing().lastNumber + 1
          && untouched(['counterId', 'workspaceId', 'prefix', 'financialYear'].toSet());

        allow delete: if false;
      }

      match /idempotency/{requestId} {
        allow read, write: if false;
      }

      match /lockDates/{lockId} {
        allow get, list: if isMember(wid);
        allow write: if false;
      }

      // -----------------------------------------------------------------
      // settings — readable by members, writable by Super Admin except for
      // the accounting lock date, which only a function may move.
      // -----------------------------------------------------------------

      match /settings/{settingsDoc} {
        allow get, list: if isMember(wid);

        // Seeded during workspace setup, then edited by the Super Admin.
        // 'accounting' is created with lockDate null and afterwards only a
        // lock-date transaction may move it, so a closed period cannot be
        // reopened by a plain settings edit.
        allow create: if isSuperAdmin(wid)
          && incoming().workspaceId == wid
          && (settingsDoc != 'accounting' || incoming().lockDate == null)
          && hasServerCreatedAt();

        allow update: if isSuperAdmin(wid)
          && settingsDoc != 'accounting'
          && hasServerUpdatedAt();

        // The accounting lock date is the one setting with financial force,
        // so it has its own narrow rule: Super Admin only, only the lock
        // date itself may move, and the new value must be a real date or
        // null.
        //
        // Note the limit of what rules can check here: they can confirm that
        // an audit row is written in the same commit, but not that its stated
        // reason is truthful. Reopening a closed period is therefore visible
        // in the audit log rather than prevented — which is the correct
        // trade for a system where a genuine mistake must still be fixable.
        allow update: if isSuperAdmin(wid)
          && settingsDoc == 'accounting'
          && changedKeys().hasOnly(['lockDate', 'updatedAt'])
          && (incoming().lockDate == null || isLedgerDate(incoming().lockDate))
          && hasServerUpdatedAt();

        allow delete: if false;
      }

      // -----------------------------------------------------------------
      // notifications — a user reads their own and may mark them read.
      // -----------------------------------------------------------------

      match /notifications/{notificationId} {
        allow get, list: if isMember(wid)
          && (resource.data.recipientUid == request.auth.uid
              || resource.data.recipientUid == null);

        allow update: if isMember(wid)
          && resource.data.recipientUid == request.auth.uid
          && changedKeys().hasOnly(['readAt'])
          && incoming().readAt == request.time;

        allow create, delete: if false;
      }
    }

    // ===================================================================
    // Anything not matched above is denied.
    // ===================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
