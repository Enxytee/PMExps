# PMExps — local development environment
#
# NOTE: the Firebase *web* config (apiKey, authDomain, projectId, …) is NOT
# secret and is committed in js/config/firebase-config.js. It does not belong
# here. This file is only for values used by scripts and Cloud Functions
# during local development.
#
# Never commit a filled-in copy of this file.

# Firebase project to target from the CLI
FIREBASE_PROJECT_ID=pmexps

# Emulator host overrides (leave default unless ports clash)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Seed script — emulator-only demo accounts. These passwords are used ONLY
# against the emulator and must never exist in the production project.
SEED_SUPERADMIN_EMAIL=admin@demo.local
SEED_SUPERADMIN_PASSWORD=Demo!Admin2026
SEED_ACCOUNTANT_EMAIL=accountant@demo.local
SEED_ACCOUNTANT_PASSWORD=Demo!Acct2026
SEED_VIEWER_EMAIL=viewer@demo.local
SEED_VIEWER_PASSWORD=Demo!View2026

# Production secrets are NOT stored here. Cloud Function secrets are set with:
#   firebase functions:secrets:set SECRET_NAME
